{
    "name": "openchamber-squeez-stats",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "OpenChamber extension: squeez compression stats in a side panel",
    "openchamber": {
        "apiVersion": 1,
        "engines": {
            "openchamber": ">=2.0.4"
        },
        "contributes": {
            "panel": {
                "id": "squeez-stats",
                "name": "Squeez Stats",
                "icon": "icon.svg",
                "entry": "panel/index.html"
            },
            "statusSection": {
                "entry": "panel/index.html",
                "title": "Squeez",
                "height": 84
            },
            "service": {
                "entry": "service/main.js",
                "runtime": "host"
            }
        }
    },
    "scripts": {
        "build": "bun run build:panel && bun run build:service",
        "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
        "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
        "typecheck": "tsc --noEmit",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "@openchamber/sdk": "^2.1.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "typescript": "^5.9.2"
    }
}
